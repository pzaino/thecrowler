-- v1.16 is a PostgreSQL-only autovacuum tuning change; MySQL has no
-- equivalent storage parameter.  This ledger-only migration keeps upgraded
-- MySQL databases at the same schema version as fresh installs so the
-- 1.16 writer compatibility check passes either way.
UPDATE DBSchemaVersion SET is_current=FALSE;
INSERT INTO DBSchemaVersion(version,description,is_current)
VALUES('1.16','CROWler DB schema version 1.16',TRUE)
ON DUPLICATE KEY UPDATE description=VALUES(description),is_current=TRUE;
