-- Version 1.17 adds verified source ownership provenance. Durable crawl
-- approvals are PostgreSQL/SQLite-only in this release; MySQL keeps the
-- ownership provenance contract but reports the approval store as unsupported.
-- The migration is additive and safe to re-run.
CREATE TABLE IF NOT EXISTS SourceOwnership (
    source_id BIGINT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    verified_at TIMESTAMP NOT NULL,
    verified_by_user_id BIGINT NOT NULL,
    verified_by VARCHAR(255) NOT NULL,
    verification_method VARCHAR(64) NOT NULL,
    verification_reason TEXT,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    last_updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CHECK (user_id > 0),
    CHECK (verified_by_user_id > 0),
    INDEX idx_sourceownership_user (user_id)
) ENGINE=InnoDB;

UPDATE DBSchemaVersion SET is_current=FALSE;
INSERT INTO DBSchemaVersion(version,description,is_current)
VALUES('1.17','CROWler DB schema version 1.17',TRUE)
ON DUPLICATE KEY UPDATE description=VALUES(description),is_current=TRUE;

INSERT INTO DatabaseWriterCompatibility(lock_id,writer_generation)
VALUES(1,'verified-ownership-v1.17')
ON DUPLICATE KEY UPDATE writer_generation=VALUES(writer_generation);
