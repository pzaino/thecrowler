CREATE TABLE IF NOT EXISTS TimeSeriesSeriesSlots (metric_id INTEGER NOT NULL REFERENCES TimeSeriesMetrics(metric_id) ON DELETE RESTRICT,slot_number INTEGER NOT NULL,series_hash VARCHAR(64) NOT NULL,identity_value TEXT NOT NULL,PRIMARY KEY(metric_id,slot_number),UNIQUE(metric_id,series_hash));
CREATE TABLE IF NOT EXISTS TimeSeriesDimensionSlots (metric_id INTEGER NOT NULL REFERENCES TimeSeriesMetrics(metric_id) ON DELETE RESTRICT,dimension_key TEXT NOT NULL,slot_number INTEGER NOT NULL,value_hash VARCHAR(64) NOT NULL,identity_value TEXT NOT NULL,PRIMARY KEY(metric_id,dimension_key,slot_number),UNIQUE(metric_id,dimension_key,value_hash));
INSERT OR IGNORE INTO TimeSeriesSeriesSlots SELECT metric_id,ROW_NUMBER() OVER(PARTITION BY metric_id ORDER BY series_hash)-1,series_hash,series_identity FROM TimeSeriesActiveSeries;
INSERT OR IGNORE INTO TimeSeriesDimensionSlots SELECT metric_id,dimension_key,ROW_NUMBER() OVER(PARTITION BY metric_id,dimension_key ORDER BY value_hash)-1,value_hash,canonical_value FROM TimeSeriesActiveDimensionValues;
INSERT OR IGNORE INTO DBSchemaVersion(version,description,is_current) VALUES('1.15','Fine-grained time-series cardinality slots',1);
UPDATE DBSchemaVersion SET is_current=(version='1.15') WHERE version IN ('1.14','1.15');
