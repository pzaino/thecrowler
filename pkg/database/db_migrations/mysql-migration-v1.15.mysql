CREATE TABLE IF NOT EXISTS TimeSeriesSeriesSlots (metric_id BIGINT NOT NULL,slot_number BIGINT NOT NULL,series_hash VARCHAR(64) NOT NULL,identity_value TEXT NOT NULL,PRIMARY KEY(metric_id,slot_number),UNIQUE(metric_id,series_hash),FOREIGN KEY(metric_id) REFERENCES TimeSeriesMetrics(metric_id) ON DELETE RESTRICT) ENGINE=InnoDB;
CREATE TABLE IF NOT EXISTS TimeSeriesDimensionSlots (metric_id BIGINT NOT NULL,dimension_key VARCHAR(255) NOT NULL,slot_number BIGINT NOT NULL,value_hash VARCHAR(64) NOT NULL,identity_value TEXT NOT NULL,PRIMARY KEY(metric_id,dimension_key,slot_number),UNIQUE(metric_id,dimension_key,value_hash),FOREIGN KEY(metric_id) REFERENCES TimeSeriesMetrics(metric_id) ON DELETE RESTRICT) ENGINE=InnoDB;
INSERT IGNORE INTO TimeSeriesSeriesSlots SELECT metric_id,ROW_NUMBER() OVER(PARTITION BY metric_id ORDER BY series_hash)-1,series_hash,series_identity FROM TimeSeriesActiveSeries;
INSERT IGNORE INTO TimeSeriesDimensionSlots SELECT metric_id,dimension_key,ROW_NUMBER() OVER(PARTITION BY metric_id,dimension_key ORDER BY value_hash)-1,value_hash,canonical_value FROM TimeSeriesActiveDimensionValues;
CREATE TABLE IF NOT EXISTS TimeSeriesObservationSeries (observation_id BIGINT NOT NULL,metric_id BIGINT NOT NULL,series_hash VARCHAR(64) NOT NULL,PRIMARY KEY(observation_id,metric_id,series_hash),KEY idx_ts_observation_series_identity(metric_id,series_hash),FOREIGN KEY(observation_id) REFERENCES TimeSeriesObservations(observation_id) ON DELETE CASCADE,FOREIGN KEY(metric_id,series_hash) REFERENCES TimeSeriesActiveSeries(metric_id,series_hash) ON DELETE RESTRICT) ENGINE=InnoDB;
CREATE TABLE IF NOT EXISTS TimeSeriesObservationDimensions (observation_id BIGINT NOT NULL,metric_id BIGINT NOT NULL,dimension_key VARCHAR(255) NOT NULL,value_hash VARCHAR(64) NOT NULL,PRIMARY KEY(observation_id,metric_id,dimension_key,value_hash),KEY idx_ts_observation_dimensions_identity(metric_id,dimension_key,value_hash),FOREIGN KEY(observation_id) REFERENCES TimeSeriesObservations(observation_id) ON DELETE CASCADE,FOREIGN KEY(metric_id,dimension_key,value_hash) REFERENCES TimeSeriesActiveDimensionValues(metric_id,dimension_key,value_hash) ON DELETE RESTRICT) ENGINE=InnoDB;
INSERT IGNORE INTO TimeSeriesObservationSeries SELECT observation_id,metric_id,series_hash FROM TimeSeriesObservations WHERE deleted_at IS NULL;
INSERT IGNORE INTO TimeSeriesObservationDimensions SELECT o.observation_id,o.metric_id,a.dimension_key,a.value_hash FROM TimeSeriesObservations o JOIN TimeSeriesActiveDimensionValues a ON a.metric_id=o.metric_id AND JSON_CONTAINS_PATH(o.dimensions,'one',CONCAT('$.',JSON_QUOTE(a.dimension_key))) AND JSON_EXTRACT(o.dimensions,CONCAT('$.',JSON_QUOTE(a.dimension_key)))=CAST(a.canonical_value AS JSON) WHERE o.deleted_at IS NULL;
ALTER TABLE TimeSeriesActiveSeries ALTER reference_count SET DEFAULT 1;
ALTER TABLE TimeSeriesActiveDimensionValues ALTER reference_count SET DEFAULT 1;
INSERT INTO DBSchemaVersion(version,description,is_current) SELECT '1.15','Fine-grained cardinality slots and normalized observation memberships',TRUE WHERE NOT EXISTS(SELECT 1 FROM DBSchemaVersion WHERE version='1.15');
UPDATE DBSchemaVersion SET is_current=(version='1.15') WHERE version IN ('1.14','1.15');
