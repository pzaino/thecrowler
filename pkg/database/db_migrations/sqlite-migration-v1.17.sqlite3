-- Version 1.17 adds durable crawl-approval persistence and verified source
-- ownership provenance. This is the SQLite parity migration; it advances the
-- writer generation with the schema so old and new writers cannot share the
-- database.
BEGIN;


---------------------------------------------------------------------------------
-- Verified source ownership provenance. Sources.usr_id remains the stored owner,
-- but only a matching row here makes that ownership authoritative. Historical
-- sources without a provenance row stay legacy/unverified until an administrator
-- explicitly verifies them.
CREATE TABLE IF NOT EXISTS SourceOwnership (
    source_id INTEGER PRIMARY KEY,
    user_id INTEGER NOT NULL,
    verified_at TIMESTAMP NOT NULL,
    verified_by_user_id INTEGER NOT NULL,
    verified_by TEXT NOT NULL,
    verification_method TEXT NOT NULL,
    verification_reason TEXT,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    last_updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CHECK (user_id > 0),
    CHECK (verified_by_user_id > 0)
);

CREATE INDEX IF NOT EXISTS idx_sourceownership_user
ON SourceOwnership(user_id);

CREATE TABLE IF NOT EXISTS CrawlApprovals (
    approval_id CHAR(64) PRIMARY KEY,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    last_updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    proposal_sha256 CHAR(64) NOT NULL,
    request_id TEXT NOT NULL,
    run_id TEXT NOT NULL,
    agent_id TEXT NOT NULL,
    owner TEXT NOT NULL,
    principal_user_id INTEGER NOT NULL,
    source_id INTEGER NOT NULL,
    operation_type TEXT NOT NULL,

    issuer TEXT NOT NULL,
    issued_by_user_id INTEGER NOT NULL,
    issued_by TEXT NOT NULL,
    issued_by_issuer TEXT NOT NULL,
    approved_by_user_id INTEGER NOT NULL,
    approved_by TEXT NOT NULL,
    approved_by_issuer TEXT NOT NULL,
    approval_sha256 CHAR(64) NOT NULL,

    proposal_expires_at TIMESTAMP NOT NULL,
    approved_at TIMESTAMP NOT NULL,
    expires_at TIMESTAMP NOT NULL,

    revoked_at TIMESTAMP,
    revoked_by_user_id INTEGER,
    revoked_by TEXT,
    revocation_reason TEXT,

    UNIQUE (request_id, run_id, principal_user_id, source_id, operation_type),
    CHECK (
        length(approval_id) = 64 AND length(proposal_sha256) = 64 AND length(approval_sha256) = 64
    ),
    CHECK (expires_at > approved_at),
    CHECK (julianday(expires_at) - julianday(approved_at) <= 1.0)
);

CREATE INDEX IF NOT EXISTS idx_crawlapprovals_source
ON CrawlApprovals(source_id, expires_at);

CREATE INDEX IF NOT EXISTS idx_crawlapprovals_principal
ON CrawlApprovals(principal_user_id, expires_at);

CREATE INDEX IF NOT EXISTS idx_crawlapprovals_request
ON CrawlApprovals(run_id, request_id);

INSERT INTO DatabaseWriterCompatibility(lock_id,writer_generation)
VALUES(1,'verified-ownership-v1.17')
ON CONFLICT(lock_id) DO UPDATE SET writer_generation=excluded.writer_generation;


---------------------------------------------------------------------------------
-- Durable crawl proposals. Approval state remains in CrawlApprovals.
CREATE TABLE IF NOT EXISTS CrawlProposals (
    request_id CHAR(64) PRIMARY KEY,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    last_updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    run_id TEXT NOT NULL,
    tool_call_id TEXT NOT NULL,
    agent_id TEXT NOT NULL,
    owner TEXT NOT NULL,
    principal_user_id INTEGER NOT NULL,
    source_id INTEGER NOT NULL,
    operation_type TEXT NOT NULL,
    proposal_sha256 CHAR(64) NOT NULL,
    trace_id TEXT NOT NULL DEFAULT '',
    max_requests INTEGER NOT NULL,
    budget_window_seconds INTEGER NOT NULL,
    policy_json TEXT NOT NULL,
    state TEXT NOT NULL DEFAULT 'pending',
    expires_at TIMESTAMP NOT NULL,
    submitted_at TIMESTAMP,
    operation_id TEXT,

    UNIQUE (run_id, tool_call_id, source_id, operation_type),
    CHECK (length(request_id) = 64 AND length(proposal_sha256) = 64),
    CHECK (state IN ('pending', 'submitted', 'expired', 'denied'))
);

CREATE INDEX IF NOT EXISTS idx_crawlproposals_run_request
ON CrawlProposals(run_id, request_id);

CREATE INDEX IF NOT EXISTS idx_crawlproposals_principal
ON CrawlProposals(principal_user_id, expires_at);

CREATE INDEX IF NOT EXISTS idx_crawlproposals_source
ON CrawlProposals(source_id, expires_at);

UPDATE DBSchemaVersion SET is_current=0;
INSERT INTO DBSchemaVersion(version,description,is_current)
VALUES('1.17','Durable crawl approval persistence',1)
ON CONFLICT(version) DO UPDATE SET description=excluded.description,is_current=1;

COMMIT;
