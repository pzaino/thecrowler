CREATE TABLE IF NOT EXISTS TimeSeriesActiveSeries (metric_id BIGINT NOT NULL, series_hash VARCHAR(64) NOT NULL, series_identity TEXT NOT NULL, reference_count BIGINT NOT NULL, PRIMARY KEY(metric_id,series_hash), FOREIGN KEY(metric_id) REFERENCES TimeSeriesMetrics(metric_id) ON DELETE RESTRICT, CHECK(reference_count > 0)) ENGINE=InnoDB;
CREATE TABLE IF NOT EXISTS TimeSeriesActiveDimensionValues (metric_id BIGINT NOT NULL, dimension_key VARCHAR(255) NOT NULL, value_hash VARCHAR(64) NOT NULL, canonical_value TEXT NOT NULL, reference_count BIGINT NOT NULL, PRIMARY KEY(metric_id,dimension_key,value_hash), FOREIGN KEY(metric_id) REFERENCES TimeSeriesMetrics(metric_id) ON DELETE RESTRICT, CHECK(reference_count > 0)) ENGINE=InnoDB;
